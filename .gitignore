# The standalone product is deliberately tracked; all other executables are build outputs.
*.exe
!app/GamesDock.exe
bin/
obj/
artifacts/
TestResults/
_dev/
*.obj
*.pdb
*.bak
*.tmp
*.out.txt
*.err.txt

# User data and credentials never belong in source control.
.env
.env.*
!.env.example
config.json
dock.log
settings-fixtures/
icons/
cards/

# Generated test images; only curated documentation images are tracked.
*.png
*.gif
!docs/logo.png
!docs/screenshots/**/*.png

# Windows / IDE state.
Thumbs.db
desktop.ini
.vs/
.idea/
*.user
*.suo
